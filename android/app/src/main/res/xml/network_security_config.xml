<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext HTTP is off by default. A handful of video CDNs still serve
        plain-HTTP media URLs, so those hosts are opted in individually rather
        than opening every connection in the app with usesCleartextTraffic.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">tikwm.com</domain>
        <domain includeSubdomains="true">tiktokcdn.com</domain>
        <domain includeSubdomains="true">tiktokcdn-us.com</domain>
        <domain includeSubdomains="true">akamaized.net</domain>
    </domain-config>

    <!-- Local dev proxy (server.js) when running against a desktop machine. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
